<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             id="InvoiceTolerancePolicyDefs"
             name="InvoiceTolerancePolicy"
             namespace="http://kaartech.com/exchange-recon/policies">
  <decision id="Decision_InvoiceTolerance" name="InvoiceTolerancePolicy">
    <description>Owned by Finance. Governs the deterministic tolerance gate in the P2P
invoice-to-PO reconciliation. Price tolerance 2.0%, quantity tolerance 1 unit,
four-eyes threshold GBP 25,000. Changing these thresholds requires no deployment.</description>
    <decisionTable id="DecisionTable_InvoiceTolerance" hitPolicy="FIRST">
      <input id="Input_PriceVariancePct" label="price_variance_pct">
        <inputExpression id="InputExpr_PriceVariancePct" typeRef="number">
          <text>price_variance_pct</text>
        </inputExpression>
      </input>
      <input id="Input_QtyVarianceUnits" label="qty_variance_units">
        <inputExpression id="InputExpr_QtyVarianceUnits" typeRef="number">
          <text>qty_variance_units</text>
        </inputExpression>
      </input>
      <input id="Input_LineValueGbp" label="line_value_gbp">
        <inputExpression id="InputExpr_LineValueGbp" typeRef="number">
          <text>line_value_gbp</text>
        </inputExpression>
      </input>
      <output id="Output_Decision" label="decision" name="decision" typeRef="string" />
      <rule id="Rule_FourEyes">
        <description>High-value line: four-eyes approval regardless of variance</description>
        <inputEntry id="R1_Price"><text>-</text></inputEntry>
        <inputEntry id="R1_Qty"><text>-</text></inputEntry>
        <inputEntry id="R1_Value"><text>&gt; 25000</text></inputEntry>
        <outputEntry id="R1_Out"><text>"four-eyes-approval"</text></outputEntry>
      </rule>
      <rule id="Rule_PriceBreach">
        <description>Price variance outside tolerance: human review with evidence</description>
        <inputEntry id="R2_Price"><text>&gt; 2</text></inputEntry>
        <inputEntry id="R2_Qty"><text>-</text></inputEntry>
        <inputEntry id="R2_Value"><text>-</text></inputEntry>
        <outputEntry id="R2_Out"><text>"human-review"</text></outputEntry>
      </rule>
      <rule id="Rule_QtyBreach">
        <description>Quantity variance outside tolerance: human review with evidence</description>
        <inputEntry id="R3_Price"><text>-</text></inputEntry>
        <inputEntry id="R3_Qty"><text>&gt; 1</text></inputEntry>
        <inputEntry id="R3_Value"><text>-</text></inputEntry>
        <outputEntry id="R3_Out"><text>"human-review"</text></outputEntry>
      </rule>
      <rule id="Rule_AutoClear">
        <description>Within all tolerances: auto-clear, zero human touch</description>
        <inputEntry id="R4_Price"><text>&lt;= 2</text></inputEntry>
        <inputEntry id="R4_Qty"><text>&lt;= 1</text></inputEntry>
        <inputEntry id="R4_Value"><text>&lt;= 25000</text></inputEntry>
        <outputEntry id="R4_Out"><text>"auto-clear"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="Diagram_InvoiceTolerance">
      <dmndi:DMNShape id="Shape_Decision" dmnElementRef="Decision_InvoiceTolerance">
        <dc:Bounds x="160" y="100" width="220" height="80" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
