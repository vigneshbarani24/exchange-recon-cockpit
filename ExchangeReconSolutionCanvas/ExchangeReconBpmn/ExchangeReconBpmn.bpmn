        <uipath:inputOutput id="error2" name="Error" type="jsonSchema" elementId="Task_Tolerance"><![CDATA[{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"detail":{"type":"string"},"category":{"type":"string"},"status":{"type":"number"},"element":{"type":"string"}}}]]></uipath:inputOutput>
        <uipath:inputOutput id="response" name="response" type="Maestro.ReceiveMessageEvent" elementId="Event_Approve" />
        <uipath:inputOutput id="responseEsc" name="responseEsc" type="Maestro.ReceiveMessageEvent" elementId="Event_EscalateMsg" />
