    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_start" name="Supplier invoice received">
      <bpmn:extensionElements>
        <uipath:entryPointId value="ec7053b7-6bb1-4617-a077-dc837ddc5e99" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_start_match</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_MatchAgent" name="Matching agent: align supplier lines to PO">
      <bpmn:extensionElements>
        <uipath:tags>
          <uipath:tag key="caseTaskType">agent</uipath:tag>
        </uipath:tags>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgentJob" version="v2" />
          <uipath:context>
            <uipath:input name="name" type="string" value="=bindings.bAUw4b7LT" />
            <uipath:input name="folderPath" type="string" value="=bindings.bXvluh6D5" />
            <uipath:input name="_label" type="string" value="matching-agent" />
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"purchase_order":{"type":"string"},"supplier_document":{"type":"string"}},"required":["purchase_order","supplier_document"]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"purchase_order":"=vars.Var_PurchaseOrder","supplier_document":"=vars.Var_SupplierDocument"}]]></uipath:input>
          <uipath:output name="Error" type="jsonSchema" source="=Error" var="error" />
          <uipath:output name="purchase_order" type="string" source="=purchase_order" var="purchaseOrder" />
          <uipath:output name="summary" type="string" description="One-line summary of the matching result." source="=summary" var="summary" />
          <uipath:output name="matched_lines" type="jsonSchema" subType="object" source="=matched_lines" var="matchedLines" />
          <uipath:output name="unmatched_supplier_lines" type="jsonSchema" subType="string" source="=unmatched_supplier_lines" var="unmatchedSupplierLines" />
          <uipath:output name="unmatched_po_items" type="jsonSchema" subType="string" source="=unmatched_po_items" var="unmatchedPoItems" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_match</bpmn:incoming>
      <bpmn:outgoing>Flow_match_tolerance</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_MatchError" attachedToRef="Task_MatchAgent">
      <bpmn:outgoing>Flow_match_error</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_MatchError" errorRef="Error_AgentFailed" />
    </bpmn:boundaryEvent>
    <bpmn:scriptTask id="Task_Tolerance" name="Tolerance check" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"matchedLines":"=vars.matchedLines"}]]></uipath:input>
          <uipath:output name="withinTolerance" type="boolean" source="=result.response.withinTolerance" var="tolWithin" />
          <uipath:output name="variances" type="string" source="=result.response.variances" var="tolVariances" />
          <uipath:output name="scriptResponse" type="jsonSchema" source="=result.response" var="scriptResponse" />
          <uipath:output name="Error" type="jsonSchema" source="=Error" var="error2" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_match_tolerance</bpmn:incoming>
      <bpmn:outgoing>Flow_tolerance_gateway</bpmn:outgoing>
      <bpmn:script><![CDATA[
var priceTolerancePct = 2.0;
var qtyTolerance = 1.0;
var lines = matchedLines;
if (typeof lines === "string") { try { lines = JSON.parse(lines); } catch (e) { lines = []; } }
if (!Array.isArray(lines)) { lines = (lines && lines.lines) || []; }
var offending = [];
for (var i = 0; i < lines.length; i++) {
  var line = lines[i];
  var poPrice = Number(line.po_unit_price);
  var invoicePrice = Number(line.supplier_unit_price);
  var poQty = Number(line.po_quantity);
  var invoiceQty = Number(line.supplier_quantity);
  var priceDelta = poPrice === 0 ? 0 : Math.abs((invoicePrice - poPrice) / poPrice) * 100;
  var qtyDelta = Math.abs(invoiceQty - poQty);
  if (priceDelta > priceTolerancePct || qtyDelta > qtyTolerance) {
    offending.push("Item " + (line.po_item || (i + 1)) + ": price " + priceDelta.toFixed(1) + "% / qty " + qtyDelta.toFixed(1));
  }
}
var withinTolerance = offending.length === 0;
return { response: { withinTolerance: withinTolerance, variances: offending.length ? offending.join("; ") : "none" } };
]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_Tolerance" name="Within tolerance?" default="Flow_variance">
      <bpmn:incoming>Flow_tolerance_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_within_tolerance</bpmn:outgoing>
      <bpmn:outgoing>Flow_variance</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_AutoApprove" name="Post / auto-approve" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"variances":"=vars.tolVariances"}]]></uipath:input>
          <uipath:output name="scriptResponse" type="jsonSchema" source="=result.response" var="scriptResponse2" />
          <uipath:output name="Error" type="jsonSchema" source="=Error" var="error5" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_within_tolerance</bpmn:incoming>
      <bpmn:outgoing>Flow_autoapprove_end</bpmn:outgoing>
      <bpmn:script><![CDATA[
return { response: "Within tolerance. Invoice auto-approved and PO matched for posting." };
]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_AutoApproved" name="Auto-approved">
      <bpmn:incoming>Flow_autoapprove_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_VarianceAgent" name="Variance agent: classify and propose correction">
      <bpmn:extensionElements>
        <uipath:tags>
          <uipath:tag key="caseTaskType">agent</uipath:tag>
        </uipath:tags>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgentJob" version="v2" />
          <uipath:context>
            <uipath:input name="name" type="string" value="=bindings.bcY1xCOU4" />
            <uipath:input name="folderPath" type="string" value="=bindings.bhvgx4mbZ" />
            <uipath:input name="_label" type="string" value="variance-agent" />
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"purchase_order":{"type":"string"},"supplier_document":{"type":"string"},"tolerance_pct":{"type":"number"}},"required":["purchase_order","supplier_document"]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"purchase_order":"=vars.Var_PurchaseOrder","supplier_document":"=vars.Var_SupplierDocument","tolerance_pct":2}]]></uipath:input>
          <uipath:output name="Error" type="jsonSchema" source="=Error" var="error3" />
          <uipath:output name="purchase_order" type="string" source="=purchase_order" var="purchaseOrder2" />
          <uipath:output name="overall_status" type="string" description="within-tolerance | variance-found | error" source="=overall_status" var="overallStatus" />
          <uipath:output name="summary" type="string" description="One-line summary of the reconciliation outcome." source="=summary" var="summary2" />
          <uipath:output name="confidence" type="number" description="0.0–1.0 confidence in the reconciliation; lower it when ambiguous." source="=confidence" var="confidence" />
          <uipath:output name="line_variances" type="jsonSchema" subType="object" source="=line_variances" var="lineVariances" />
          <uipath:output name="prepared_corrections" type="jsonSchema" subType="object" source="=prepared_corrections" var="preparedCorrections" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_variance</bpmn:incoming>
      <bpmn:outgoing>Flow_agent_gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_AgentError" attachedToRef="Task_VarianceAgent">
      <bpmn:outgoing>Flow_agent_error</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_AgentError" errorRef="Error_AgentFailed" />
    </bpmn:boundaryEvent>
    <bpmn:eventBasedGateway id="GW_HumanWait" name="Human gate: await decision">
      <bpmn:incoming>Flow_agent_gate</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_wait_escalate</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_Approve" name="Approved">
      <bpmn:extensionElements>
        <uipath:event version="v1">
          <uipath:type value="Maestro.ReceiveMessageEvent" version="v1" />
          <uipath:context>
            <uipath:input name="name" type="string" value="ApproveGate" />
          </uipath:context>
          <uipath:input name="Reference" displayName="Reference" type="string" value="=vars.Var_PurchaseOrder" target="bodyField" required="true" />
          <uipath:output name="response" type="Maestro.ReceiveMessageEvent" var="response" />
        </uipath:event>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_wait_approve</bpmn:incoming>
      <bpmn:outgoing>Flow_approve</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Approve" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_EscalateMsg" name="Escalated by reviewer">
      <bpmn:extensionElements>
        <uipath:event version="v1">
          <uipath:type value="Maestro.ReceiveMessageEvent" version="v1" />
          <uipath:context>
            <uipath:input name="name" type="string" value="EscalateGate" />
          </uipath:context>
          <uipath:input name="Reference" displayName="Reference" type="string" value="=vars.Var_PurchaseOrder" target="bodyField" required="true" />
          <uipath:output name="response" type="Maestro.ReceiveMessageEvent" var="responseEsc" />
        </uipath:event>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_wait_escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_escalate</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Escalate" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_PostingPrepAgent" name="Posting-prep agent: build PO item update">
      <bpmn:extensionElements>
        <uipath:tags>
          <uipath:tag key="caseTaskType">agent</uipath:tag>
        </uipath:tags>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgentJob" version="v2" />
          <uipath:context>
            <uipath:input name="name" type="string" value="=bindings.bUM3ae8T8" />
            <uipath:input name="folderPath" type="string" value="=bindings.bCCHGCrmu" />
            <uipath:input name="_label" type="string" value="posting-prep-agent" />
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"purchase_order":{"type":"string"},"po_item":{"type":"string"},"approved_action":{"type":"string"}},"required":["purchase_order","po_item","approved_action"]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"purchase_order":"=vars.Var_PurchaseOrder","po_item":"=vars.matchedLines[0].po_item","approved_action":"=js: (vars.lineVariances && vars.lineVariances[0] && vars.lineVariances[0].proposed_correction) || 'Accept the over-delivery; update the PO order quantity to 6.'"}]]></uipath:input>
          <uipath:output name="Error" type="jsonSchema" source="=Error" var="error4" />
          <uipath:output name="purchase_order" type="string" source="=purchase_order" var="purchaseOrder3" />
          <uipath:output name="po_item" type="string" source="=po_item" var="poItem" />
          <uipath:output name="update_entity" type="string" description="The S/4 OData entity to update (A_PurchaseOrderItemType)." source="=update_entity" var="updateEntity" />
          <uipath:output name="field_updates" type="jsonSchema" subType="object" source="=field_updates" var="fieldUpdates" />
          <uipath:output name="human_summary" type="string" description="One line a buyer can read: what will change, from what to what." source="=human_summary" var="humanSummary" />
          <uipath:output name="ready_to_post" type="boolean" description="True only if the update is well-formed and safe to hand to the deterministic post step." source="=ready_to_post" var="readyToPost" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_approve</bpmn:incoming>
      <bpmn:outgoing>Flow_prep_update</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_PrepError" attachedToRef="Task_PostingPrepAgent">
      <bpmn:outgoing>Flow_prep_error</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_PrepError" errorRef="Error_AgentFailed" />
    </bpmn:boundaryEvent>
    <bpmn:scriptTask id="Task_UpdatePO" name="Update PO item in S/4" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"purchaseOrder":"=vars.Var_PurchaseOrder","preparedUpdate":"=vars.humanSummary","reviewerNote":""}]]></uipath:input>
          <uipath:output name="outcome" type="string" source="=result.response" var="Var_Outcome" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_prep_update</bpmn:incoming>
      <bpmn:outgoing>Flow_update_end</bpmn:outgoing>
      <bpmn:script><![CDATA[
var note = reviewerNote ? " Reviewer note: " + reviewerNote : "";
return { response: "PO item " + (purchaseOrder || "") + " correction prepared for S/4 (write-back held)." + note };
]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Corrected" name="Corrected &#38; closed">
      <bpmn:incoming>Flow_update_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Task_RouteBuyer" name="Route to buyer" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="outcome" type="string" source="=result.response" var="Var_Outcome" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_match_error</bpmn:incoming>
      <bpmn:incoming>Flow_agent_error</bpmn:incoming>
      <bpmn:incoming>Flow_prep_error</bpmn:incoming>
      <bpmn:incoming>Flow_escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_routebuyer_end</bpmn:outgoing>
      <bpmn:script><![CDATA[
return { response: "Escalated to the buyer for manual handling." };
]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Escalated" name="Escalated">
      <bpmn:incoming>Flow_routebuyer_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_match" sourceRef="Event_start" targetRef="Task_MatchAgent" />
    <bpmn:sequenceFlow id="Flow_match_tolerance" sourceRef="Task_MatchAgent" targetRef="Task_Tolerance" />
    <bpmn:sequenceFlow id="Flow_match_error" sourceRef="Boundary_MatchError" targetRef="Task_RouteBuyer" />
    <bpmn:sequenceFlow id="Flow_tolerance_gateway" sourceRef="Task_Tolerance" targetRef="Gateway_Tolerance" />
    <bpmn:sequenceFlow id="Flow_within_tolerance" name="Within tolerance" sourceRef="Gateway_Tolerance" targetRef="Task_AutoApprove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.tolWithin == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_variance" name="Variance" sourceRef="Gateway_Tolerance" targetRef="Task_VarianceAgent" />
    <bpmn:sequenceFlow id="Flow_autoapprove_end" sourceRef="Task_AutoApprove" targetRef="End_AutoApproved" />
    <bpmn:sequenceFlow id="Flow_agent_gate" sourceRef="Task_VarianceAgent" targetRef="GW_HumanWait" />
    <bpmn:sequenceFlow id="Flow_agent_error" sourceRef="Boundary_AgentError" targetRef="Task_RouteBuyer" />
    <bpmn:sequenceFlow id="Flow_wait_approve" sourceRef="GW_HumanWait" targetRef="Event_Approve" />
    <bpmn:sequenceFlow id="Flow_wait_escalate" sourceRef="GW_HumanWait" targetRef="Event_EscalateMsg" />
    <bpmn:sequenceFlow id="Flow_approve" name="Approve" sourceRef="Event_Approve" targetRef="Task_PostingPrepAgent" />
    <bpmn:sequenceFlow id="Flow_prep_update" sourceRef="Task_PostingPrepAgent" targetRef="Task_UpdatePO" />
    <bpmn:sequenceFlow id="Flow_prep_error" sourceRef="Boundary_PrepError" targetRef="Task_RouteBuyer" />
    <bpmn:sequenceFlow id="Flow_update_end" sourceRef="Task_UpdatePO" targetRef="End_Corrected" />
    <bpmn:sequenceFlow id="Flow_escalate" name="Escalate" sourceRef="Event_EscalateMsg" targetRef="Task_RouteBuyer" />
    <bpmn:sequenceFlow id="Flow_routebuyer_end" sourceRef="Task_RouteBuyer" targetRef="End_Escalated" />
  </bpmn:process>
