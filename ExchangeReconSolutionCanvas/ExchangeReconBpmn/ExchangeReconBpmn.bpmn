        <uipath:inputOutput id="summary2" name="summary" type="string" elementId="Task_VarianceAgent" />
        <uipath:inputOutput id="confidence" name="confidence" type="number" elementId="Task_VarianceAgent" />
        <uipath:inputOutput id="lineVariances" name="line_variances" type="jsonSchema" subType="object" elementId="Task_VarianceAgent"><![CDATA[{"items":{"properties":{"po_item":{"description":"PO item number, e.g. '10'.","title":"Po Item","type":"string"},"material":{"title":"Material","type":"string"},"description":{"title":"Description","type":"string"},"po_quantity":{"title":"Po Quantity","type":"string"},"supplier_quantity":{"title":"Supplier Quantity","type":"string"},"po_unit_price":{"title":"Po Unit Price","type":"string"},"supplier_unit_price":{"title":"Supplier Unit Price","type":"string"},"currency":{"title":"Currency","type":"string"},"variance_category":{"description":"One of: price-variance, quantity-variance, uom-mismatch, material-mismatch, currency-mismatch, tax-variance, missing-line, duplicate-line, over-delivery, under-delivery, none.","title":"Variance Category","type":"string"},"variance_amount":{"description":"The quantified line variance with currency, e.g. '+£125.00'.","title":"Variance Amount","type":"string"},"explanation":{"description":"Plain-English reason the line disagrees.","title":"Explanation","type":"string"},"proposed_correction":{"description":"Recommended PO-item correction for a human buyer to APPROVE before any write — never a write itself.","title":"Proposed Correction","type":"string"}},"title":"LineVariance","type":"object"},"title":"Line Variances","type":"array","$schema":"http://json-schema.org/draft-07/schema#"}]]></uipath:inputOutput>
        <uipath:inputOutput id="preparedCorrections" name="prepared_corrections" type="jsonSchema" subType="object" elementId="Task_VarianceAgent"><![CDATA[{"description":"For each line with a variance, the S/4 update that would correct it — prepared, never posted. The deterministic step posts only after human approval.","items":{"properties":{"po_item":{"title":"Po Item","type":"string"},"entity":{"description":"The S/4 OData entity to update (A_PurchaseOrderItem).","title":"Entity","type":"string"},"field":{"description":"The S/4 field to change: OrderQuantity for a quantity correction, NetPriceAmount for a price correction.","title":"Field","type":"string"},"current_value":{"description":"The current S/4 value (read from the PO).","title":"Current Value","type":"string"},"new_value":{"description":"The value that resolves the variance.","title":"New Value","type":"string"},"summary":{"description":"One line a buyer reads: what changes, from/to.","title":"Summary","type":"string"},"ready_to_post":{"description":"True if well-formed and safe to hand to the deterministic post step.","title":"Ready To Post","type":"boolean"}},"title":"PreparedCorrection","type":"object"},"title":"Prepared Corrections","type":"array","$schema":"http://json-schema.org/draft-07/schema#"}]]></uipath:inputOutput>
        <uipath:inputOutput id="error3" name="Error" type="jsonSchema" elementId="Task_VarianceAgent"><![CDATA[{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"detail":{"type":"string"},"category":{"type":"string"},"status":{"type":"number"},"element":{"type":"string"}}}]]></uipath:inputOutput>
