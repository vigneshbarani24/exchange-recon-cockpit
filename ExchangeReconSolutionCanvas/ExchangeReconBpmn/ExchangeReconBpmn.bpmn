        <uipath:inputOutput id="matchedLines" name="matched_lines" type="jsonSchema" subType="object" elementId="Task_MatchAgent"><![CDATA[{"items":{"properties":{"po_item":{"description":"PO item number, e.g. '10'.","title":"Po Item","type":"string"},"material":{"title":"Material","type":"string"},"description":{"title":"Description","type":"string"},"po_quantity":{"title":"Po Quantity","type":"string"},"po_unit_price":{"title":"Po Unit Price","type":"string"},"supplier_quantity":{"title":"Supplier Quantity","type":"string"},"supplier_unit_price":{"title":"Supplier Unit Price","type":"string"},"currency":{"title":"Currency","type":"string"},"match_basis":{"description":"How the supplier line was matched to the PO item (e.g. 'material' or 'description').","title":"Match Basis","type":"string"},"match_confidence":{"description":"0.0–1.0 confidence in this line match.","title":"Match Confidence","type":"number"}},"title":"MatchedLine","type":"object"},"title":"Matched Lines","type":"array","$schema":"http://json-schema.org/draft-07/schema#"}]]></uipath:inputOutput>
        <uipath:inputOutput id="unmatchedSupplierLines" name="unmatched_supplier_lines" type="jsonSchema" subType="string" elementId="Task_MatchAgent"><![CDATA[{"description":"Supplier lines with no corresponding PO item.","items":{"type":"string"},"title":"Unmatched Supplier Lines","type":"array","$schema":"http://json-schema.org/draft-07/schema#"}]]></uipath:inputOutput>
        <uipath:inputOutput id="unmatchedPoItems" name="unmatched_po_items" type="jsonSchema" subType="string" elementId="Task_MatchAgent"><![CDATA[{"description":"PO items not referenced by the supplier document.","items":{"type":"string"},"title":"Unmatched Po Items","type":"array","$schema":"http://json-schema.org/draft-07/schema#"}]]></uipath:inputOutput>
