        <uipath:inputOutput id="updateEntity" name="update_entity" type="string" elementId="Task_PostingPrepAgent" />
        <uipath:inputOutput id="fieldUpdates" name="field_updates" type="jsonSchema" subType="object" elementId="Task_PostingPrepAgent"><![CDATA[{"description":"The field(s) to change, each with its current and new value. The row keys are PurchaseOrder=purchase_order and PurchaseOrderItem=po_item.","items":{"properties":{"field":{"description":"S/4 field name, e.g. 'OrderQuantity' or 'NetPriceAmount'.","title":"Field","type":"string"},"current_value":{"description":"Current S/4 value (read via MCP), for the audit trail.","title":"Current Value","type":"string"},"new_value":{"description":"The new value to write.","title":"New Value","type":"string"}},"title":"FieldUpdate","type":"object"},"title":"Field Updates","type":"array","$schema":"http://json-schema.org/draft-07/schema#"}]]></uipath:inputOutput>
        <uipath:inputOutput id="humanSummary" name="human_summary" type="string" elementId="Task_PostingPrepAgent" />
        <uipath:inputOutput id="readyToPost" name="ready_to_post" type="boolean" elementId="Task_PostingPrepAgent" />
        <uipath:inputOutput id="error4" name="Error" type="jsonSchema" elementId="Task_PostingPrepAgent"><![CDATA[{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"detail":{"type":"string"},"category":{"type":"string"},"status":{"type":"number"},"element":{"type":"string"}}}]]></uipath:inputOutput>
        <uipath:inputOutput id="scriptResponse2" name="scriptResponse" type="jsonSchema" elementId="Task_AutoApprove" />
        <uipath:inputOutput id="error5" name="Error" type="jsonSchema" elementId="Task_AutoApprove"><![CDATA[{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"detail":{"type":"string"},"category":{"type":"string"},"status":{"type":"number"},"element":{"type":"string"}}}]]></uipath:inputOutput>
        <uipath:output id="Var_Outcome" name="outcome" type="string" />
      </uipath:variables>
      <uipath:bindings version="v1">
        <uipath:binding id="Binding_MatchAgentName" name="matching-agent" type="process" elementId="Task_MatchAgent" resource="process" resourceSubType="Agent" resourceKey="531c73eb-7b26-44a3-8608-143f8cdf5746" propertyAttribute="name" />
        <uipath:binding id="Binding_MatchAgentFolderPath" name="matching-agent" type="process" elementId="Task_MatchAgent" resource="process" resourceSubType="Agent" resourceKey="531c73eb-7b26-44a3-8608-143f8cdf5746" propertyAttribute="folderPath" />
        <uipath:binding id="Binding_VarianceAgentName" name="variance-agent" type="process" elementId="Task_VarianceAgent" resource="process" resourceSubType="Agent" resourceKey="3963cb83-fb46-4b0f-9913-7503af04d7e6" propertyAttribute="name" />
        <uipath:binding id="Binding_VarianceAgentFolderPath" name="variance-agent" type="process" elementId="Task_VarianceAgent" resource="process" resourceSubType="Agent" resourceKey="3963cb83-fb46-4b0f-9913-7503af04d7e6" propertyAttribute="folderPath" />
        <uipath:binding id="Binding_PostingPrepAgentName" name="posting-prep-agent" type="process" elementId="Task_PostingPrepAgent" resource="process" resourceSubType="Agent" resourceKey="13818f2e-f7f3-4de4-9448-095c56ad5441" propertyAttribute="name" />
        <uipath:binding id="Binding_PostingPrepAgentFolderPath" name="posting-prep-agent" type="process" elementId="Task_PostingPrepAgent" resource="process" resourceSubType="Agent" resourceKey="13818f2e-f7f3-4de4-9448-095c56ad5441" propertyAttribute="folderPath" />
        <uipath:binding id="bdFH7NMKq" name="releaseKey" type="string" default="531C73EB-7B26-44A3-8608-143F8CDF5746" resource="process" resourceKey="531C73EB-7B26-44A3-8608-143F8CDF5746" propertyAttribute="Key" />
        <uipath:binding id="bXvluh6D5" name="folderPath" type="string" resource="process" resourceSubType="Agent" resourceKey="matching-agent" propertyAttribute="folderPath" />
        <uipath:binding id="bAUw4b7LT" name="name" type="string" default="matching-agent" resource="process" resourceSubType="Agent" resourceKey="matching-agent" propertyAttribute="name" />
        <uipath:binding id="bolqfu8y9" name="releaseKey" type="string" default="3963CB83-FB46-4B0F-9913-7503AF04D7E6" resource="process" resourceKey="3963CB83-FB46-4B0F-9913-7503AF04D7E6" propertyAttribute="Key" />
        <uipath:binding id="bhvgx4mbZ" name="folderPath" type="string" resource="process" resourceSubType="Agent" resourceKey="variance-agent" propertyAttribute="folderPath" />
        <uipath:binding id="bcY1xCOU4" name="name" type="string" default="variance-agent" resource="process" resourceSubType="Agent" resourceKey="variance-agent" propertyAttribute="name" />
        <uipath:binding id="bdbvAIua2" name="releaseKey" type="string" default="13818F2E-F7F3-4DE4-9448-095C56AD5441" resource="process" resourceKey="13818F2E-F7F3-4DE4-9448-095C56AD5441" propertyAttribute="Key" />
        <uipath:binding id="bCCHGCrmu" name="folderPath" type="string" resource="process" resourceSubType="Agent" resourceKey="posting-prep-agent" propertyAttribute="folderPath" />
        <uipath:binding id="bUM3ae8T8" name="name" type="string" default="posting-prep-agent" resource="process" resourceSubType="Agent" resourceKey="posting-prep-agent" propertyAttribute="name" />
